<!-- Page Header -->
<div class="card content-section" style="border-bottom: 1px solid var(--gray-200);">
  <div class="container-wide">
    <div class="flex justify-between items-center">
      <div>
        <h1 class="text-3xl font-bold" style="color: var(--gray-800);">
          <%= @course.subject %> <%= @course.catalog_number %>: <%= @course.title %>
        </h1>
        <p style="margin-top: var(--spacing-sm); color: var(--gray-600);">Course Details and Sections</p>
      </div>
      <div class="flex items-center gap-md">
        <%= link_to "Edit Course", edit_admin_course_path(@course), class: "btn btn-primary" %>
        <%= link_to "Back to Courses", admin_courses_path, class: "btn btn-secondary" %>
      </div>
    </div>
  </div>
</div>

<!-- Course Information -->
<div class="container-wide" style="padding: var(--spacing-xl) 0;">
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    
    <!-- Course Detail Panel -->
    <div class="lg:col-span-2">
      <div class="card">
        <div class="card-header">
          <h2 class="card-title">Course Information</h2>
        </div>

        <div class="space-y-4">
          <!-- Basic Info -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <% [["Course ID", @course.course_id], 
                ["Subject", @course.subject], 
                ["Catalog Number", @course.catalog_number],
                ["Term", @course.term],
                ["Campus", @course.campus],
                ["Sections Count", pluralize(@course.sections.count, "section")]].each do |label, value| %>
              <div>
                <label class="text-sm font-medium text-gray-500"><%= label %></label>
                <p class="text-gray-900"><%= value %></p>
              </div>
            <% end %>
          </div>

          <!-- Title -->
          <div>
            <label class="text-sm font-medium text-gray-500">Title</label>
            <p class="text-gray-900"><%= @course.title %></p>
          </div>

          <!-- Short Description -->
          <% if @course.short_description.present? %>
            <div>
              <label class="text-sm font-medium text-gray-500">Short Description</label>
              <p class="text-gray-900"><%= @course.short_description %></p>
            </div>
          <% end %>

          <!-- Full Description -->
          <% if @course.description.present? %>
            <div>
              <label class="text-sm font-medium text-gray-500">Description</label>
              <div class="text-gray-900 whitespace-pre-wrap"><%= @course.description %></div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Quick Actions -->
    <div>
      <div class="card">
        <div class="card-header">
          <h3 class="card-title">Quick Actions</h3>
        </div>

        <div class="space-y-3">
          <%= link_to "Edit Course", edit_admin_course_path(@course), class: "btn btn-primary w-full" %>

          <%= link_to "Add Section", new_admin_course_section_path(@course), 
              class: "btn btn-secondary w-full" %>

          <%= link_to "Delete Course", admin_course_path(@course),
              method: :delete,
              data: { turbo_confirm: "Are you sure you want to delete this course? This will also delete all associated sections." },
              class: "btn btn-danger w-full" %>
        </div>
      </div>
    </div>

  </div>

  <!-- Sections Table -->
  <div class="mt-8">
    <div class="card">
      <div class="card-header">
        <div class="flex justify-between items-center">
          <h2 class="card-title">Course Sections</h2>
          <%= link_to "Add New Section", new_admin_course_section_path(@course),
              class: "btn btn-primary btn-sm" %>
        </div>
      </div>

      <% if @sections.any? %>
        <div class="overflow-x-auto">
          <table class="table">
            <thead>
              <tr>
                <th>Class Number</th>
                <th>Section Code</th>
                <th>Component</th>
                <th>Mode</th>
                <th>Status</th>
                <th>Location</th>
                <th class="text-center">Actions</th>
              </tr>
            </thead>

            <tbody>
              <% @sections.each do |section| %>
                <tr class="hover:bg-gray-50">
                  <td><%= section.class_number %></td>
                  <td><%= section.section_code %></td>
                  <td><%= section.component %></td>
                  <td><%= section.instruction_mode %></td>
                  <td>
                    <% if section.enrollment_status.present? %>
                      <span class="px-2 py-1 text-xs rounded-full <%= section.enrollment_status.downcase == "open" ? "bg-green-100 text-green-800" : "bg-red-100 text-red-800" %>">
                        <%= section.enrollment_status %>
                      </span>
                    <% else %>
                      <span class="text-gray-400 text-sm">N/A</span>
                    <% end %>
                  </td>
                  <td><%= section.location.presence || "N/A" %></td>

                  <!-- Correct Action Buttons -->
                  <td class="text-center">
                    <div class="flex justify-center gap-2">
                      <%= link_to "Edit",
                          edit_admin_course_section_path(@course, section),
                          class: "text-blue-600 hover:text-blue-800 text-sm font-medium" %>

                      <%= link_to "Delete",
                          admin_course_section_path(@course, section),
                          method: :delete,
                          data: {
                            turbo: "false",
                            turbo_confirm: "Are you sure?"
                          },
                          class: "text-red-600 hover:text-red-800 text-sm font-medium"
                      %>

                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>

      <% else %>
        <div class="py-12 text-center">
          <svg class="w-12 h-12 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
          </svg>
          <h3 class="text-lg font-medium text-gray-dark mb-2">No sections found</h3>
          <p class="text-gray-600 mb-4">This course doesn't have any sections yet.</p>
          <%= link_to "Add First Section", new_admin_course_section_path(@course),
              class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>

</div>
