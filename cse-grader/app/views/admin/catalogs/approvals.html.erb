<!-- Page Header -->
<div class="card" style="border-bottom: 1px solid var(--gray-200);">
  <div class="container-wide">
    <div class="flex justify-between items-center">
      <div>
        <h1 class="text-3xl font-bold" style="color: var(--gray-800);">User Approvals</h1>
        <p style="margin-top: var(--spacing-sm); color: var(--gray-600));">Review and approve pending instructor and admin registrations</p>
      </div>
      <div class="flex items-center gap-md">
        <div class="text-right">
          <div class="text-sm" style="color: var(--gray-500);">Pending Approvals</div>
          <div class="text-2xl font-bold" style="color: var(--osu-scarlet);">
            <%= @pending&.count || 0 %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Stats Cards -->
<div class="container-wide" style="padding: var(--spacing-xl) 0;">
  <div class="grid grid-cols-3" style="gap: var(--spacing-lg); margin-bottom: var(--spacing-xl);">
    <div class="card">
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <div class="w-12 h-12 bg-yellow-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
        </div>
        <div class="ml-4">
          <div class="text-2xl font-bold text-gray-dark">
            <%= @pending&.count || 0 %>
          </div>
          <div class="text-sm text-gray-600">Total Pending</div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <div class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
          </div>
        </div>
        <div class="ml-4">
          <div class="text-2xl font-bold text-gray-dark">
            <%= @pending&.select { |u| u.role == 'instructor' }&.count || 0 %>
          </div>
          <div class="text-sm text-gray-600">Instructors</div>
        </div>
      </div>
    </div>

    <div class="card">
      <div class="flex items-center">
        <div class="flex-shrink-0">
          <div class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center">
            <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
        </div>
        <div class="ml-4">
          <div class="text-2xl font-bold text-gray-dark">
            <%= @pending&.select { |u| u.role == 'admin' }&.count || 0 %>
          </div>
          <div class="text-sm text-gray-600">Administrators</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Pending Users Table -->
  <% if @pending && @pending.any? %>
    <div class="bg-white shadow-sm rounded-lg overflow-hidden">
      <div class="px-6 py-4 border-b border-gray-200">
        <h3 class="text-lg font-medium text-gray-dark">Pending Approvals</h3>
        <p class="mt-1 text-sm text-gray-600">Review and approve user registrations</p>
      </div>
      
      <div class="overflow-x-auto">
        <table class="table">
          <thead>
            <tr>
              <th class="text-left">User Information</th>
              <th class="text-center">Role</th>
              <th class="text-center">Registration Date</th>
              <th class="text-center">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% @pending.each do |user| %>
              <tr class="hover:bg-gray-50">
                <td class="py-4">
                  <div class="flex items-center">
                    <div class="w-10 h-10 bg-scarlet text-white rounded-full flex items-center justify-center font-medium">
                      <%= (user.name || user.email).first.upcase %>
                    </div>
                    <div class="ml-4">
                      <div class="text-sm font-medium text-gray-dark">
                        <%= user.name || user.email %>
                      </div>
                      <div class="text-sm text-gray-600">
                        <%= user.email %>
                      </div>
                    </div>
                  </div>
                </td>
                <td class="py-4 text-center">
                  <span class="status-badge status-<%= user.role %>">
                    <%= user.role.capitalize %>
                  </span>
                </td>
                <td class="py-4 text-center">
                  <span class="text-sm text-gray-600">
                    <%= user.created_at.strftime("%b %d, %Y") %>
                  </span>
                </td>
                <td class="py-4 text-center">
                  <div class="flex items-center justify-center space-x-2">
                    <%= button_to "Approve", approve_admin_catalog_path(user_id: user.id), 
                        method: :post, 
                        class: "bg-green-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2 transition-all duration-200",
                        confirm: "Are you sure you want to approve this user?" %>
                    <button class="bg-red-600 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 transition-all duration-200">
                      Reject
                    </button>
                  </div>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <!-- Empty State -->
    <div class="bg-white shadow-sm rounded-lg">
      <div class="py-12 text-center">
        <svg class="w-12 h-12 text-green-500 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <h3 class="text-lg font-medium text-gray-dark mb-2">All caught up!</h3>
        <p class="text-gray-600 mb-6">There are no pending user approvals at this time.</p>
        <div class="flex justify-center space-x-4">
          <%= link_to "View All Users", "#", 
              class: "bg-scarlet text-white px-4 py-2 rounded-lg hover:bg-scarlet-dark transition-all duration-200" %>
          <%= link_to "Course Management", "#", 
              class: "bg-gray-600 text-white px-4 py-2 rounded-lg hover:bg-gray-700 transition-all duration-200" %>
        </div>
      </div>
    </div>
  <% end %>
</div>
<!-- List pending elevated accounts so admins can approve them -->
<h1>Approve Instructors/Admins</h1>
<% if (@pending || []).any? %>
  <table>
    <tr><th>Email</th><th>Role</th><th></th></tr>
    <% @pending.each do |u| %>
      <tr>
        <td><%= u.email %></td>
        <td><%= u.role %></td>
        <td>
          <%= button_to "Approve", approve_admin_catalog_path(user_id: u.id), method: :post %>
          <%= button_to "Deny", deny_admin_catalog_path(user_id: u.id), method: :post, data: { turbo_confirm: "Are you sure you want to deny this request?" } %>
        </td>
      </tr>
    <% end %>
  </table>
<% else %>
  <p>No pending instructor or admin accounts at this time.</p>
<% end %>
