<%# ---- Show validation errors ---- %>
<% if section.errors.any? %>
  <div class="alert alert-danger">
    <h4><%= pluralize(section.errors.count, "error") %> prevented the section from being saved:</h4>
    <ul>
      <% section.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%# ---- Main form (PATCH when editing, POST when creating) ---- %>
<%= form_with url: section.persisted? ?
                  admin_course_section_path(course, section) :
                  admin_course_sections_path(course),
              method: section.persisted? ? :patch : :post,
              scope: :section,
              local: true do |f| %>

  <div>
    <%= f.label :section_code %>
    <%= f.text_field :section_code %>
  </div>

  <div>
    <%= f.label :semester %>
    <%= f.text_field :semester %>
  </div>

  <div>
    <%= f.label :component, "Component (LEC/LAB/REC)" %>
    <%= f.text_field :component, placeholder: "LEC" %>
  </div>

  <div>
    <%= f.label :instruction_mode, "Instruction Mode" %>
    <%= f.text_field :instruction_mode, placeholder: "In Person" %>
  </div>

  <div>
    <%= f.label :meeting_day %>
    <%= f.text_field :meeting_day %>
  </div>

  <div>
    <%= f.label :meeting_start %>
    <%= f.text_field :meeting_start, placeholder: "14:20" %>
  </div>

  <div>
    <%= f.label :meeting_end %>
    <%= f.text_field :meeting_end, placeholder: "16:20" %>
  </div>

  <div>
    <%= f.label :required_graders %>
    <%= f.number_field :required_graders %>
  </div>

  <div style="margin-top: 1rem;">
    <%= f.submit class: "btn btn-primary" %>
  </div>

<% end %>
